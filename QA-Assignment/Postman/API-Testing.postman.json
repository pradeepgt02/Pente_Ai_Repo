              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "description": "Adversarial payload. Expect the request to be handled safely (stored as literal text or rejected) with no 500 error indicating a raw SQL failure. Related to DEF-003 in DefectReport.xlsx.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"' OR '1'='1\",\n  \"email\": \"sqli_test@example.com\",\n  \"password\": \"'; DROP TABLE users; --\",\n  \"confirmPassword\": \"'; DROP TABLE users; --\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No server error (5xx) \u2014 payload handled safely', function () {",
                  "    pm.expect(pm.response.code).to.be.below(500);",
                  "});"
                ]
              }
            }
          ]
        },
