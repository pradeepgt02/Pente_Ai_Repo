{
  "name": "webmind-playwright-automation",
  "version": "1.0.0",
  "description": "Playwright JavaScript Test Automation Framework for WebMind AI Application",
  "main": "playwright.config.js",
  "type": "module",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:report": "npx playwright show-report reports",
    "test:login": "npx playwright test tests/login.spec.js",
    "test:crud": "npx playwright test tests/crud.spec.js",
    "test:aichat": "npx playwright test tests/aiChat.spec.js",
    "test:logout": "npx playwright test tests/logout.spec.js"
  },
  "keywords": [
    "playwright",
    "automation",
    "sdet",
    "testing",
    "javascript",
    "e2e",
    "webmind"
  ],
  "author": "Senior SDET",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "dotenv": "^16.4.7"
  }
}
