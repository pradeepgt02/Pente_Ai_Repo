# Copy this file to .env and fill in real values. Never commit .env itself.

# Application under test
BASE_URL=http://localhost:5173

# Dedicated automation test account (should already exist, or be created by
# the global setup script — see README "Test data" section)
TEST_USER_EMAIL=qa.automation@example.com
TEST_USER_PASSWORD=Test@1234
TEST_USER_NAME=Pradeepkumar

# A stable, low-change public site used as the crawl target for the
# knowledge base CRUD test
TEST_WEBSITE_URL=https://www.python.org
TEST_WEBSITE_LABEL=python.org

# A question with a known, verifiable answer within TEST_WEBSITE_URL,
# used for the AI interaction test
TEST_CHAT_QUESTION=What is Python?
